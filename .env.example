# Copy to .env or export in your shell. Everything is optional:
# with none of these set, the system runs fully offline with no API key.

# Corpus directory (default: ./corpus relative to the repo root)
# RAG_DOCS_DIR=/path/to/docs

# Sentence-overlap threshold for the groundedness check (default: 0.35).
# See evals/tune_threshold.py for the measured trade-off curve.
# RAG_GROUNDING_THRESHOLD=0.35

# Optional: compose answers with an OpenAI-compatible provider instead
# of the built-in offline composer. The groundedness check still
# verifies every sentence either way.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
